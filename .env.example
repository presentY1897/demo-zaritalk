# ===== DB =====
# Prisma CLI용: packages/db/.env 로 복사
# 앱 런타임용: apps/web/.env.local, apps/admin/.env.local 에도 필요
DATABASE_URL="postgresql://zari:zari@localhost:5432/zari"

# ===== 지도/통근시간 (apps/web/.env.local) =====
# https://developers.kakao.com — JavaScript 키(지도), REST API 키(주소 검색 + 자동차 길찾기)
NEXT_PUBLIC_KAKAO_MAP_JS_KEY=""
KAKAO_REST_API_KEY=""
# 자동차 통근시간(T3.5)은 위 REST 키로 카카오모빌리티 길찾기를 실호출한다.
#   GET https://apis-navi.kakaomobility.com/v1/directions?origin=<경도,위도>&destination=<경도,위도>
#       &priority=RECOMMEND&summary=true   /  Authorization: KakaoAK <REST 키>
# 키가 없으면 자동차 값만 비고(NO_KEY) 대중교통 값은 그대로 나온다 — 화면은 죽지 않는다.
#
# https://lab.odsay.com — 대중교통 길찾기.
# **아직 쓰지 않는다**: 대중교통은 모의 제공자다([D9](docs/DECISIONS.md) 확정).
# 카카오모빌리티 REST 에는 대중교통 경로 API 가 없다. 키가 생기면
# apps/web/src/features/commute/odsay.ts 를 만들고 providers.ts 의 transit 자리만 바꾼다
# (자세한 절차는 docs/tasks/t3.5-commute.md 의 "ODsay 로 교체할 때" 절).
ODSAY_API_KEY=""

# ===== 실거래가 (국토교통부, 공공데이터포털) =====
# 활용신청: https://www.data.go.kr/data/15126474/openapi.do (아파트 전월세)
#           https://www.data.go.kr/data/15126469/openapi.do (아파트 매매)
# 엔드포인트: https://apis.data.go.kr/1613000/RTMSDataSvcAptRent/getRTMSDataSvcAptRent
#             https://apis.data.go.kr/1613000/RTMSDataSvcAptTrade/getRTMSDataSvcAptTrade
# **디코딩 키**를 넣는다 — 포털이 주는 인코딩 키를 그대로 넣고 URLSearchParams 로
# 조립하면 이중 인코딩돼 SERVICE_KEY_IS_NOT_REGISTERED 가 난다.
# 응답은 XML 이고 금액 단위는 **만원**(예: deposit "35,000"), 콤마가 섞인 문자열이다.
DATA_GO_KR_API_KEY=""

# ===== 자리페이 (토스페이먼츠 테스트 키) =====
# https://developers.tosspayments.com
# gck/gsk = 결제위젯(Payment Widget) SDK 용 통합 키. ck/sk(구버전 결제창)와 다르다.
# 아래 값은 토스 문서에 공개된 체험용 키다 — 계정에 묶이지 않아 대시보드에서 조회되지 않는다.
# 자기 계정 키로 바꾸려면 이 두 값만 교체하면 된다.
NEXT_PUBLIC_TOSS_CLIENT_KEY="test_gck_docs_Ovk5rk1EwkEbP0W43n07xlzm"
TOSS_SECRET_KEY="test_gsk_docs_OaPz8L5KdmQXkzRz3y47BMw6"
# 웹훅(T2.1): 개발자센터 > 웹훅 메뉴에 `PAYMENT_STATUS_CHANGED` 를 아래 URL 로 등록한다.
#   https://<배포도메인>/api/toss/webhook
# 결제 상태 웹훅에는 서명 헤더가 없어(서명은 payout/seller 이벤트 전용) 본문을 신뢰하지 않고
# 시크릿 키로 `GET /v1/payments/{paymentKey}` 를 다시 호출해 검증한다 — 별도 시크릿이 필요 없다.
# 로컬은 공개 URL 이 아니라 웹훅을 받을 수 없다(ngrok 같은 터널이 필요).
# 토스 코어 API 주소를 바꿔야 하면(스테이징 목 서버 등) TOSS_API_BASE 로 덮어쓴다.
# TOSS_API_BASE="https://api.tosspayments.com"

# ===== 원장 크론 (T1.4) + 실거래가 수집 (T4.3) =====
# POST/GET /api/cron/daily 인증 시크릿.
# 이 크론은 원장 작업 뒤에 실거래가 수집(구독·최근 수집 지역의 당월+전월)도 이어서 돌린다.
# 같은 시크릿으로 POST /api/deals/sync 도 부를 수 있다(어드민 /deals 화면·curl).
# - Vercel Cron 은 이 값이 프로젝트 환경변수에 있으면 `Authorization: Bearer <값>` 으로 호출한다
# - 어드민 수동 트리거·curl 은 `x-cron-secret: <값>` 헤더를 쓴다
# apps/web/.env.local 과 apps/admin/.env.local 에 **같은 값**을 넣는다. 없으면 크론은 401 이다.
CRON_SECRET="local-dev-cron-secret"

# 어드민(3001)이 크론을 호출할 web 앱 주소 (apps/admin/.env.local). 배포 시 web 도메인으로 바꾼다.
NEXT_PUBLIC_WEB_URL="http://localhost:3000"

# ===== 어드민 로그인 (T6.3) =====
# 어드민 앱에는 원래 로그인이 없었다(주소만 알면 열렸다). T6.3 이 그 문을 닫았고,
# 로그인은 **관리자 전화번호 + 어드민 패스코드** 두 가지로 한다:
#   - 전화번호  → 누구인지. web 이 DB 에서 `User.isAdmin` 인 계정을 찾는다(시드: 01000000000)
#   - 패스코드  → 들어와도 되는지. 공개 API 로는 얻을 수 없는 서버 값이다
# 왜 OTP 가 아닌가: 데모의 `POST /api/auth/otp/request` 는 **코드를 응답에 그대로 실어 준다**(T0.3).
# 누구든 관리자 번호로 코드를 받아 낼 수 있어 OTP 로는 문이 잠기지 않는다.
#
# 값을 정하는 순서: ADMIN_PASSWORD → ADMIN_API_SECRET → CRON_SECRET.
# **셋 다 없으면 어드민 로그인은 전부 거부된다(fail closed)** — 환경변수를 빠뜨린 배포가
# "인증 없음" 으로 열리는 것이 T6.3 이 없애려는 바로 그 상태다.
# 운영에서는 사람이 치는 값(ADMIN_PASSWORD)과 서버가 쓰는 값(ADMIN_API_SECRET)을 반드시 나눈다.
# apps/web/.env.local 에 넣는다. 로컬은 비워 두면 CRON_SECRET 으로 떨어져 그대로 동작한다.
ADMIN_PASSWORD=""

# 어드민 서버 → web API 의 **서비스 자격**(헤더 `x-admin-secret`). 신분이 아니라 통로의 자격이라,
# 이 값이 맞아도 web 은 실재하는 `isAdmin` 계정을 찾아 행위자로 기록한다(T2.5).
# 어드민 로그인(POST /api/admin/session)과 기존 어드민 화면(환급 심사·신고 처리)이 쓴다.
# web·admin **두 앱에 같은 값**을 넣는다. 비워 두면 CRON_SECRET 을 쓴다.
ADMIN_API_SECRET=""

# ===== 서류 업로드 (Vercel Blob, D3) =====
# 환급 신청 서류(계약서·등본)는 개인정보라 **private** 스토어를 쓴다 —
# public 이면 URL 만으로 등본이 열린다. 읽기도 서명 URL 을 거친다.
# 스토어: zari-demo-docs (Vercel 대시보드 Storage). web·admin 두 프로젝트가 같은 토큰을 쓴다.
# `vercel env pull` / `vercel blob create-store` 가 .env.local 을 덮어쓸 수 있으니
# 그 뒤에는 DATABASE_URL 이 로컬을 가리키는지 반드시 확인할 것.
BLOB_READ_WRITE_TOKEN=""
