# ===== DB =====
# Prisma CLI용: packages/db/.env 로 복사
# 앱 런타임용: apps/web/.env.local, apps/admin/.env.local 에도 필요
DATABASE_URL="postgresql://zari:zari@localhost:5432/zari"

# ===== 지도/통근시간 (apps/web/.env.local) =====
# https://developers.kakao.com — JavaScript 키(지도), REST API 키(길찾기)
NEXT_PUBLIC_KAKAO_MAP_JS_KEY=""
KAKAO_REST_API_KEY=""
# https://lab.odsay.com — 대중교통 길찾기
ODSAY_API_KEY=""

# ===== 실거래가 (국토교통부, 공공데이터포털) =====
# https://www.data.go.kr — 아파트/연립 매매·전월세 실거래가 활용신청
DATA_GO_KR_API_KEY=""

# ===== 자리페이 (토스페이먼츠 테스트 키) =====
# https://developers.tosspayments.com
# gck/gsk = 결제위젯(Payment Widget) SDK 용 통합 키. ck/sk(구버전 결제창)와 다르다.
# 아래 값은 토스 문서에 공개된 체험용 키다 — 계정에 묶이지 않아 대시보드에서 조회되지 않는다.
# 자기 계정 키로 바꾸려면 이 두 값만 교체하면 된다.
NEXT_PUBLIC_TOSS_CLIENT_KEY="test_gck_docs_Ovk5rk1EwkEbP0W43n07xlzm"
TOSS_SECRET_KEY="test_gsk_docs_OaPz8L5KdmQXkzRz3y47BMw6"

# ===== 원장 크론 (T1.4) =====
# POST/GET /api/cron/daily 인증 시크릿.
# - Vercel Cron 은 이 값이 프로젝트 환경변수에 있으면 `Authorization: Bearer <값>` 으로 호출한다
# - 어드민 수동 트리거·curl 은 `x-cron-secret: <값>` 헤더를 쓴다
# apps/web/.env.local 과 apps/admin/.env.local 에 **같은 값**을 넣는다. 없으면 크론은 401 이다.
CRON_SECRET="local-dev-cron-secret"

# 어드민(3001)이 크론을 호출할 web 앱 주소 (apps/admin/.env.local). 배포 시 web 도메인으로 바꾼다.
NEXT_PUBLIC_WEB_URL="http://localhost:3000"

# ===== 서류 업로드 (Vercel Blob, D3) =====
# 환급 신청 서류(계약서·등본)는 개인정보라 **private** 스토어를 쓴다 —
# public 이면 URL 만으로 등본이 열린다. 읽기도 서명 URL 을 거친다.
# 스토어: zari-demo-docs (Vercel 대시보드 Storage). web·admin 두 프로젝트가 같은 토큰을 쓴다.
# `vercel env pull` / `vercel blob create-store` 가 .env.local 을 덮어쓸 수 있으니
# 그 뒤에는 DATABASE_URL 이 로컬을 가리키는지 반드시 확인할 것.
BLOB_READ_WRITE_TOKEN=""
